# From browser: DevTools → Application → Cookies → adventofcode.com → "session"
AOC_SESSION=your_session_cookie_here
# Optional: default year for --day (defaults to the current year)
YEAR=2025
# AI provider keys (set the one for --model you use; others are used as fallbacks)
GEMINI_API_KEY=your_gemini_api_key_here
HUGGINGFACE_API_KEY=your_hf_token_here   # for --model hf
NVIDIA_API_KEY=your_nvidia_key_here      # for --model nvidia (build.nvidia.com)
GROQ_API_KEY=your_groq_key_here          # for --model groq
